# =============================================================================
# Mode A (default development): local PostgreSQL 18 + npm run start:dev
# Mode B (production / Railway): copy docs/production.env.example — never this file.
# Docker is OPTIONAL and must not replace local PostgreSQL 18.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=log

# Database (PostgreSQL 18 local in Mode A)
# Must be a direct postgres:// or postgresql:// URL for the NestJS runtime.
# Do not use prisma+postgres:// here — see docs/environment.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardtrak?schema=public

# JWT (replace before staging/production — never commit real secrets)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=guardtrak-api
JWT_AUDIENCE=guardtrak-clients

# Auth / lockout / password reset
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_OTP_EXPIRES_MINUTES=10
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_RESET_TOKEN_EXPIRES_MINUTES=15
# Staging/production: keep both false. Local demo may set AUTH_ALLOW_DEV_OTP_OUTPUT=true.
AUTH_ALLOW_DEV_OTP_OUTPUT=false
AUTH_NEW_DEVICE_AUTO_APPROVE=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (ttl in milliseconds)
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Object storage (Phase 7+ evidence uploads)
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=local in staging/production (ephemeral demo disk)
STORAGE_ALLOW_EPHEMERAL=true
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_LOCAL_ROOT=./storage
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=104857600

# Shifts / attendance (Phase 5)
SHIFT_MAX_DURATION_HOURS=24
ATTENDANCE_CLOCK_IN_EARLY_MINUTES=30
ATTENDANCE_DEVICE_TIME_TOLERANCE_MINUTES=10
ATTENDANCE_IDEMPOTENCY_TTL_SECONDS=86400

# Patrols (Phase 6)
PATROL_DEVICE_TIME_TOLERANCE_MINUTES=10
PATROL_OFFLINE_REVIEW_THRESHOLD_MINUTES=30
PATROL_START_EARLY_MINUTES=15
PATROL_START_LATE_MINUTES=30
PATROL_MAX_CHECKPOINT_RADIUS_METERS=1000
PATROL_REQUIRE_SEQUENTIAL_CHECKPOINTS=true
PATROL_IDEMPOTENCY_TTL_SECONDS=86400

# Phase 7 operations
INCIDENT_IDEMPOTENCY_TTL_SECONDS=86400
EMERGENCY_IDEMPOTENCY_TTL_SECONDS=86400
SYNC_IDEMPOTENCY_TTL_SECONDS=86400

# Redis (optional in development)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=guardtrak:

# Queues
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=2

# Push (optional)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@guardtrak.local
EMAIL_RESEND_API_KEY=
AWS_SES_REGION=

# WebSockets
WS_ENABLED=true
WS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Observability
METRICS_ENABLED=true
TRUST_PROXY=true
COMPRESSION_ENABLED=true

# Swagger is enabled automatically in development/staging.
# Set explicitly to force on/off (including production if required).
# ENABLE_SWAGGER=true

# Phase 9 security / ops
AUTH_PASSWORD_HISTORY_COUNT=5
AUTH_PASSWORD_MAX_AGE_DAYS=0
AUTH_STRICT_FINGERPRINT=false
STORAGE_ORG_QUOTA_BYTES=
