# =============================================================================
# GuardTrak API — Production environment template (Mode B)
# Copy to .env on the server. NEVER commit real secrets.
# Local development: use .env.example (Mode A — PostgreSQL 18 + start:dev)
# =============================================================================

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=log

# Database — managed or host PostgreSQL 16+ (18 recommended to match dev)
DATABASE_URL=postgresql://APP_USER:STRONG_PASSWORD@db.internal:5432/guardtrak?schema=public

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=guardtrak-api
JWT_AUDIENCE=guardtrak-clients

# Auth — production-safe
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_OTP_EXPIRES_MINUTES=10
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_RESET_TOKEN_EXPIRES_MINUTES=15
AUTH_ALLOW_DEV_OTP_OUTPUT=false
AUTH_NEW_DEVICE_AUTO_APPROVE=false

# Phase 9 security / ops
AUTH_PASSWORD_HISTORY_COUNT=5
AUTH_PASSWORD_MAX_AGE_DAYS=0
AUTH_STRICT_FINGERPRINT=true
STORAGE_ORG_QUOTA_BYTES=

# CORS — real client origins only
CORS_ORIGINS=https://app.yourdomain.com
WS_CORS_ORIGINS=https://app.yourdomain.com

# Rate limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Object storage — S3 or R2 (not local for evidence)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=guardtrak-evidence-prod
STORAGE_REGION=eu-west-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=REPLACE
STORAGE_SECRET_KEY=REPLACE
STORAGE_PUBLIC_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_LOCAL_ROOT=./storage
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=104857600

# Shifts / attendance / patrols — tune per org policy
SHIFT_MAX_DURATION_HOURS=24
ATTENDANCE_CLOCK_IN_EARLY_MINUTES=30
ATTENDANCE_DEVICE_TIME_TOLERANCE_MINUTES=10
ATTENDANCE_IDEMPOTENCY_TTL_SECONDS=86400
PATROL_DEVICE_TIME_TOLERANCE_MINUTES=10
PATROL_OFFLINE_REVIEW_THRESHOLD_MINUTES=30
PATROL_START_EARLY_MINUTES=15
PATROL_START_LATE_MINUTES=30
PATROL_MAX_CHECKPOINT_RADIUS_METERS=1000
PATROL_REQUIRE_SEQUENTIAL_CHECKPOINTS=true
PATROL_IDEMPOTENCY_TTL_SECONDS=86400
INCIDENT_IDEMPOTENCY_TTL_SECONDS=86400
EMERGENCY_IDEMPOTENCY_TTL_SECONDS=86400
SYNC_IDEMPOTENCY_TTL_SECONDS=86400

# Redis — required for multi-instance / BullMQ production
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=guardtrak:

# Queues
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=4

# Push
FCM_ENABLED=true
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# Email
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
EMAIL_RESEND_API_KEY=
AWS_SES_REGION=

# WebSockets
WS_ENABLED=true

# Observability
METRICS_ENABLED=true
TRUST_PROXY=true
COMPRESSION_ENABLED=true
ENABLE_SWAGGER=false
