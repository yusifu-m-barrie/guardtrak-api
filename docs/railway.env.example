# =============================================================================
# GuardTrak API — Railway Variables (paste into Railway → API service → Variables)
# =============================================================================
# How to wire Postgres (already deployed in the same Railway project):
#   1. Open your API service → Variables
#   2. Add Variable Reference for DATABASE_URL → select Postgres → DATABASE_URL
#      (preferred: private network URL, NOT DATABASE_PUBLIC_URL)
#   3. Paste the rest of the variables below (generate JWT secrets first)
#
# Generate secrets locally:
#   openssl rand -base64 48
# =============================================================================

NODE_ENV=production
# Railway injects PORT automatically — do not hardcode unless needed
API_PREFIX=api/v1
LOG_LEVEL=log

# --- Database (from your Railway Postgres service) ---
# Reference BOTH URLs. Private is preferred; public is automatic fallback.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_PUBLIC_URL=${{Postgres.DATABASE_PUBLIC_URL}}
# If private networking fails (P1001 on postgres.railway.internal), set:
# USE_DATABASE_PUBLIC_URL=true
# DATABASE_URL=${{Postgres.DATABASE_PUBLIC_URL}}

# --- JWT (required — must NOT contain "change-me" / placeholders) ---
JWT_ACCESS_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=guardtrak-api
JWT_AUDIENCE=guardtrak-clients

# --- Auth (production-safe; validation fails if these stay true) ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_OTP_EXPIRES_MINUTES=10
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_RESET_TOKEN_EXPIRES_MINUTES=15
AUTH_ALLOW_DEV_OTP_OUTPUT=false
AUTH_NEW_DEVICE_AUTO_APPROVE=false
# Dashboard browsers auto-activate (recommended) so the first admin is not locked out
AUTH_WEB_DEVICE_AUTO_APPROVE=true
# Optional: comma-separated mobile installationIds that may switch accounts (your phone only)
# AUTH_DEVICE_OWNERSHIP_BYPASS_INSTALLATION_IDS=gt-ios-xxxx-yyyy
AUTH_PASSWORD_HISTORY_COUNT=5
AUTH_PASSWORD_MAX_AGE_DAYS=0
AUTH_STRICT_FINGERPRINT=true

# --- CORS / WebSocket ---
# Update after you deploy the dashboard (Vercel / Railway / custom domain).
# Include every browser origin that will call this API.
CORS_ORIGINS=https://YOUR-DASHBOARD-DOMAIN
WS_CORS_ORIGINS=https://YOUR-DASHBOARD-DOMAIN
WS_ENABLED=true

# --- Required behind Railway TLS edge ---
TRUST_PROXY=true
COMPRESSION_ENABLED=true
METRICS_ENABLED=true
ENABLE_SWAGGER=false

# --- Rate limiting ---
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# --- Storage ---
# Railway container disk is ephemeral. For first deploy / demo:
STORAGE_PROVIDER=local
STORAGE_ALLOW_EPHEMERAL=true
STORAGE_LOCAL_ROOT=./storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=104857600
# Later (recommended): switch to s3/r2 and remove STORAGE_ALLOW_EPHEMERAL
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL=

# --- Redis / Queues ---
# Single API replica can run without Redis (in-memory fallback).
REDIS_ENABLED=false
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=2

# --- Optional integrations (keep disabled until configured) ---
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
FCM_ENABLED=false
APNS_ENABLED=false

# --- Domain tuning (safe defaults) ---
SHIFT_MAX_DURATION_HOURS=24
ATTENDANCE_CLOCK_IN_EARLY_MINUTES=0
ATTENDANCE_DEVICE_TIME_TOLERANCE_MINUTES=10
ATTENDANCE_IDEMPOTENCY_TTL_SECONDS=86400
# Testing from outside the US site: false = still store GPS, do not reject on radius.
# Set true again when officers are at the real site.
ATTENDANCE_GEOFENCE_ENABLED=false
PATROL_DEVICE_TIME_TOLERANCE_MINUTES=10
PATROL_OFFLINE_REVIEW_THRESHOLD_MINUTES=30
PATROL_START_EARLY_MINUTES=15
PATROL_START_LATE_MINUTES=30
PATROL_MAX_CHECKPOINT_RADIUS_METERS=1000
PATROL_REQUIRE_SEQUENTIAL_CHECKPOINTS=true
PATROL_IDEMPOTENCY_TTL_SECONDS=86400
INCIDENT_IDEMPOTENCY_TTL_SECONDS=86400
EMERGENCY_IDEMPOTENCY_TTL_SECONDS=86400
SYNC_IDEMPOTENCY_TTL_SECONDS=86400
